<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- base.cr is noupdate: a <function> applies these values on every install and update.
         TODO: vat_label belongs with the identification types of cr_electronic_invoice. Decide during its 20.0 port,
         where Odoo 20's partner identifiers could replace it. It is also written as the English value, so every
         language shows the Spanish "Identificación".
         address_format: otras señas, then province, canton, district and barrio (kept in city), a more natural order
         for Costa Rican directions. -->
    <function model="res.country" name="write">
        <value eval="[ref('base.cr')]"/>
        <value eval="{
            'vat_label': 'Identificación',
            'address_format': '%(street)s\n%(state_name)s, %(county_name)s, %(district_name)s, %(city)s\n%(zip)s\n%(country_name)s',
        }"/>
    </function>
</odoo>
