<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_country_county_form" model="ir.ui.view">
        <field name="name">res.country.county.form</field>
        <field name="model">res.country.county</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="state_id" options="{'no_open': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_country_county_tree" model="ir.ui.view">
        <field name="name">res.country.county.list</field>
        <field name="model">res.country.county</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="state_id"/>
            </list>
        </field>
    </record>

    <record id="view_res_country_county_search" model="ir.ui.view">
        <field name="name">res.country.county.search</field>
        <field name="model">res.country.county</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="state_id"/>
                <filter name="group_by_state" string="Province" context="{'group_by': 'state_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_res_country_district_form" model="ir.ui.view">
        <field name="name">res.country.district.form</field>
        <field name="model">res.country.district</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="county_id" options="{'no_open': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_country_district_tree" model="ir.ui.view">
        <field name="name">res.country.district.list</field>
        <field name="model">res.country.district</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="county_id"/>
            </list>
        </field>
    </record>

    <record id="view_res_country_district_search" model="ir.ui.view">
        <field name="name">res.country.district.search</field>
        <field name="model">res.country.district</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="county_id"/>
                <filter name="group_by_county" string="Canton" context="{'group_by': 'county_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_res_country_neighborhood_form" model="ir.ui.view">
        <field name="name">res.country.neighborhood.form</field>
        <field name="model">res.country.neighborhood</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="district_id" options="{'no_open': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_country_neighborhood_tree" model="ir.ui.view">
        <field name="name">res.country.neighborhood.list</field>
        <field name="model">res.country.neighborhood</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="district_id"/>
            </list>
        </field>
    </record>

    <record id="view_res_country_neighborhood_search" model="ir.ui.view">
        <field name="name">res.country.neighborhood.search</field>
        <field name="model">res.country.neighborhood</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="district_id"/>
                <filter name="group_by_district" string="District" context="{'group_by': 'district_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_res_country_county" model="ir.actions.act_window">
        <field name="name">Cantons</field>
        <field name="res_model">res.country.county</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_res_country_district" model="ir.actions.act_window">
        <field name="name">Districts</field>
        <field name="res_model">res.country.district</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_res_country_neighborhood" model="ir.actions.act_window">
        <field name="name">Neighborhoods</field>
        <field name="res_model">res.country.neighborhood</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_res_country_county"
              name="Cantons"
              parent="account.menu_finance_configuration"
              sequence="2"
              action="action_res_country_county"/>
    <menuitem id="menu_res_country_district"
              name="Districts"
              parent="account.menu_finance_configuration"
              sequence="3"
              action="action_res_country_district"/>
    <menuitem id="menu_res_country_neighborhood"
              name="Neighborhoods"
              parent="account.menu_finance_configuration"
              sequence="4"
              action="action_res_country_neighborhood"/>

</odoo>
