<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 19-port: is_cash_count is no longer in the upstream list or form, so both xpath anchors
         failed the install ("cannot be located in parent view"). The list view already shows
         sequence (as the drag handle), so the list extension was dropped; the form now anchors on
         split_transactions, the first field of the same group. -->
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='split_transactions']" position="after">
                <field name="sequence" />
            </xpath>
        </field>
    </record>

</odoo>
