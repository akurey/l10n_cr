<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- 19-port: the receipt no longer has div.orderlines (the lines are the OrderDisplay
         component) and no longer receives a `receipt` export object - it renders from `order`
         (the PosOrder, where models.js sets number_electronic). The old xpath could not be located
         and `receipt.number_electronic` would throw, both breaking every receipt render. -->
    <t t-name="OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//OrderDisplay" position="before">
            <t t-if="order.number_electronic">
                <div class="pos-receipt-center-align">
                    Clave: <br/>
                    <t t-esc="order.number_electronic.substring(0,25)"/><br/>
                    <t t-esc="order.number_electronic.substring(25,50)"/>
                </div>
                <div class="pos-receipt-center-align">
                    Consecutivo: <br/>
                    <t t-esc="order.number_electronic.substring(21,41)"/>
                </div>
            </t>
        </xpath>
    </t>

</templates>
