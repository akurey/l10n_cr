<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Quitar el boton de Cancelar Factura -->
    <record id="view_payment_methods_tree" model="ir.ui.view">
        <field name="name">payment.methods.tree</field>
        <field name="model">payment.methods</field>
        <field name="arch" type="xml">
            <list string="Payment methods">
                <field name="sequence"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="account_payment_term_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.term.form.inherit</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="sale_conditions_id"/>
            </field>
        </field>
    </record>

    <record id="action_payment_methods" model="ir.actions.act_window">
        <field name="name">Payment methods</field>
        <field name="res_model">payment.methods</field>
        <field name="view_mode">list,form</field>
        <!--<field name="search_view_id" ref="view_account_invoice_filter"/>-->
    </record>

    <record id="view_account_payment_form_inherit" model="ir.ui.view">
        <field name="name">view.account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <notebook>
                    <page name="electronic_information" string="Electronic Information" invisible="reconciled_invoices_count == 0 and payment_type == 'inbound'">
                        <group id="fe_tab_group" col="2">
                            <group name="eref_info_group" colspan="2">
                                <group string="Electronic Receipts" name="eref_info_group2" colspan="2">
                                    <field name="sequence" readonly="1"/>
                                    <field name="fname_xml_comprobante" invisible="1" readonly="1"/>
                                    <field name="xml_comprobante" filename="fname_xml_comprobante"/>
                                    <field name="fname_xml_respuesta_tributacion" invisible="1" readonly="1"/>
                                    <field name="xml_respuesta_tributacion" filename="fname_xml_respuesta_tributacion"/>
                                    <field name="state_tributacion" readonly="1"/>
                                </group>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="after">
                <div>
                    <div class="alert alert-warning" role="alert" invisible="state_tributacion != 'procesando' or state == 'draft'">
                        The document was issued successfully, however we still do not have the answer, it will be consulted in 10 minutes, if you wish to consult it manually press
                        <button class="btn btn-primary" name="consult_rep_document" type="object" string="Consult Document"/>
                    </div>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
