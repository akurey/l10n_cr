<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_additional_contact" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.additional.contact</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="additional_contact_id"
                       readonly="state == 'cancel' or locked"
                       options="{'no_quick_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
