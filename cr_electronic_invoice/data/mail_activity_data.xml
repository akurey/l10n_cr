<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Scheduled for the company's responsible user when Hacienda rejects a document or it could not be
         sent; marked done when the document is accepted. -->
    <record id="mail_activity_einvoice_issue" model="mail.activity.type">
        <field name="name">Electronic Document Problem</field>
        <field name="res_model">account.move</field>
        <field name="icon">fa-exclamation-triangle</field>
        <field name="decoration_type">danger</field>
        <field name="delay_count">0</field>
    </record>
</odoo>
