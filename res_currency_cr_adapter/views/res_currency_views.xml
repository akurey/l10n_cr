<odoo>
    <record id="view_currency_rate_tree" model="ir.ui.view">
        <field name="name">res.currency.rate.list.inherit.res_currency_cr_adapter</field>
        <field name="model">res.currency.rate</field>
        <field name="inherit_id" ref="base.view_currency_rate_tree"/>
        <field name="arch" type="xml">
            <!-- New lines go first, as the rates are sorted newest first -->
            <xpath expr="/list" position="attributes">
                <attribute name="editable">top</attribute>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="column_invisible">context.get('l10n_cr_use_rate_format')</attribute>
            </field>
            <!-- Without the currency in the view a new line gets no default currency, and no previous rate to copy -->
            <field name="name" position="after">
                <field name="l10n_cr_date" string="Date" column_invisible="not context.get('l10n_cr_use_rate_format')"/>
                <field name="currency_id" column_invisible="True"/>
            </field>
            <!-- In the Costa Rica format, Odoo's rate columns are replaced by the same values labelled as selling -->
            <field name="company_rate" position="attributes">
                <attribute name="column_invisible">context.get('l10n_cr_use_rate_format')</attribute>
            </field>
            <field name="inverse_company_rate" position="attributes">
                <attribute name="column_invisible">context.get('l10n_cr_use_rate_format')</attribute>
            </field>
            <field name="inverse_company_rate" position="after">
                <field name="company_rate" width="140" digits="[12,12]" string="Selling Unit/Base"
                       column_invisible="not context.get('l10n_cr_use_rate_format')"/>
                <field name="l10n_cr_buying_company_rate" width="140" digits="[12,12]" string="Buying Unit/Base"
                       invisible="not l10n_cr_currency_use_rate_format"
                       column_invisible="context.get('l10n_cr_use_rate_format') == False"/>
                <field name="inverse_company_rate" width="140" digits="[12,12]" string="Selling Base/Unit"
                       column_invisible="not context.get('l10n_cr_use_rate_format')"/>
                <field name="l10n_cr_buying_inverse_company_rate" width="140" digits="[12,12]" string="Buying Base/Unit"
                       invisible="not l10n_cr_currency_use_rate_format"
                       column_invisible="context.get('l10n_cr_use_rate_format') == False"/>
            </field>
            <field name="rate" position="after">
                <field name="l10n_cr_buying_rate" digits="[12,12]" optional="hide" invisible="not l10n_cr_currency_use_rate_format"
                       column_invisible="context.get('l10n_cr_use_rate_format') == False"/>
            </field>
            <field name="write_date" position="before">
                <field name="l10n_cr_source" width="160" optional="show" readonly="True"
                       invisible="not l10n_cr_currency_use_rate_format"
                       column_invisible="context.get('l10n_cr_use_rate_format') == False"/>
            </field>
        </field>
    </record>
    <record id="view_currency_rate_search" model="ir.ui.view">
        <field name="name">res.currency.rate.search.inherit.res_currency_cr_adapter</field>
        <field name="model">res.currency.rate</field>
        <field name="inherit_id" ref="base.view_currency_rate_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <filter name="l10n_cr_source_bccr" string="From the BCCR" domain="[('l10n_cr_source', '=', 'bccr')]"/>
                <filter name="l10n_cr_source_manual" string="Entered manually" domain="[('l10n_cr_source', '=', 'manual')]"/>
            </field>
        </field>
    </record>
    <record id="view_currency_form" model="ir.ui.view">
        <field name="name">res.currency.form.inherit.res_currency_cr_adapter</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <!-- Where a buying rate is shown, Odoo's rate columns are replaced by the same values labelled as selling -->
            <xpath expr="//field[@name='rate_ids']//field[@name='name']" position="attributes">
                <attribute name="column_invisible">parent.l10n_cr_use_rate_format</attribute>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='name']" position="after">
                <field name="l10n_cr_date" string="Date" column_invisible="not parent.l10n_cr_use_rate_format"/>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='company_rate']" position="attributes">
                <attribute name="column_invisible">parent.l10n_cr_use_rate_format</attribute>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='inverse_company_rate']" position="attributes">
                <attribute name="column_invisible">parent.l10n_cr_use_rate_format</attribute>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='inverse_company_rate']" position="after">
                <field name="company_rate" width="140" digits="[12,12]" string="Selling Unit/Base"
                       column_invisible="not parent.l10n_cr_use_rate_format"/>
                <field name="l10n_cr_buying_company_rate" width="140" digits="[12,12]" string="Buying Unit/Base"
                       column_invisible="not parent.l10n_cr_use_rate_format"/>
                <field name="inverse_company_rate" width="140" digits="[12,12]" string="Selling Base/Unit"
                       column_invisible="not parent.l10n_cr_use_rate_format"/>
                <field name="l10n_cr_buying_inverse_company_rate" width="140" digits="[12,12]" string="Buying Base/Unit"
                       column_invisible="not parent.l10n_cr_use_rate_format"/>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='write_date']" position="before">
                <field name="l10n_cr_buying_rate" digits="[12,12]" optional="hide" column_invisible="not parent.l10n_cr_use_rate_format"/>
                <field name="l10n_cr_source" optional="show" readonly="True" column_invisible="not parent.l10n_cr_use_rate_format"/>
            </xpath>
            <!-- The update's status and actions, also for accounting administrators, who can't open Settings -->
            <xpath expr="//form/div[hasclass('alert')]" position="before">
                <header invisible="not l10n_cr_rates_status" groups="account.group_account_manager,base.group_system">
                    <button name="action_l10n_cr_update_rates" type="object" string="Update Now"/>
                    <button name="action_l10n_cr_open_rate_load_wizard" type="object" string="Load Past Rates"/>
                </header>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert" groups="account.group_account_manager,base.group_system"
                     invisible="l10n_cr_rates_status != 'ready'">
                    <div>
                        Rates updated through <field name="l10n_cr_rates_ready_until" class="oe_inline"/>
                    </div>
                    <div class="small">
                        <span invisible="not l10n_cr_next_update">Next automatic update <field name="l10n_cr_next_update" class="oe_inline"/></span>
                        <span invisible="not l10n_cr_next_update or not l10n_cr_last_update"> · </span>
                        <span invisible="not l10n_cr_last_update">Last update<span invisible="not l10n_cr_last_update_error"> failed</span> <field name="l10n_cr_last_update" class="oe_inline"/></span>
                    </div>
                </div>
                <div class="alert alert-warning mb-0" role="alert" groups="account.group_account_manager,base.group_system"
                     invisible="l10n_cr_rates_status not in ('late', 'missing')">
                    <div invisible="l10n_cr_rates_status != 'late'">Tomorrow's rate isn't loaded yet, rates updated through <field name="l10n_cr_rates_ready_until" class="oe_inline"/></div>
                    <div invisible="l10n_cr_rates_status != 'missing' or not l10n_cr_rates_ready_until">Today's rate is missing, rates updated through <field name="l10n_cr_rates_ready_until" class="oe_inline"/></div>
                    <div invisible="l10n_cr_rates_status != 'missing' or l10n_cr_rates_ready_until">No rates loaded yet, use "Update Now" to load them</div>
                    <div class="small">
                        <span invisible="not l10n_cr_next_update">Next automatic update <field name="l10n_cr_next_update" class="oe_inline"/></span>
                        <span invisible="not l10n_cr_next_update or not l10n_cr_last_update"> · </span>
                        <span invisible="not l10n_cr_last_update">Last update<span invisible="not l10n_cr_last_update_error"> failed</span> <field name="l10n_cr_last_update" class="oe_inline"/></span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <!-- Odoo's "Show Currency Rates" is replaced by one that shows the rates in the Costa Rica format for the currency that uses it -->
    <record id="base.act_view_currency_rates" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="action_view_currency_rates" model="ir.actions.server">
        <field name="name">Show Currency Rates</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="binding_model_id" ref="base.model_res_currency"/>
        <field name="binding_view_types">form</field>
        <field name="path">currency-rates</field>
        <field name="state">code</field>
        <field name="code">action = model.browse(env.context.get('active_id')).action_l10n_cr_view_rates()</field>
    </record>
</odoo>
