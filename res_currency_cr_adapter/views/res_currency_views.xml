<odoo>
    <record id="view_currency_rate_tree" model="ir.ui.view">
        <field name="name">res.currency.rate.list.inherit.res_currency_cr_adapter</field>
        <field name="model">res.currency.rate</field>
        <field name="inherit_id" ref="base.view_currency_rate_tree"/>
        <field name="arch" type="xml">
            <!-- New lines go first, as the rates are sorted newest first -->
            <xpath expr="/list" position="attributes">
                <attribute name="editable">top</attribute>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="column_invisible">not context.get('hide_buying_rate', True)</attribute>
            </field>
            <!-- Without the currency in the view a new line gets no default currency, and no previous rate to copy -->
            <field name="name" position="after">
                <field name="l10n_cr_date" string="Date" column_invisible="context.get('hide_buying_rate', True)"/>
                <field name="currency_id" column_invisible="True"/>
            </field>
            <field name="inverse_company_rate" position="after">
                <field name="buying_company_rate" width="140" digits="[12,12]" invisible="not currency_show_buying_rate"
                       column_invisible="context.get('hide_buying_rate')"/>
                <field name="buying_inverse_company_rate" width="140" digits="[12,12]" invisible="not currency_show_buying_rate"
                       column_invisible="context.get('hide_buying_rate')"/>
            </field>
            <field name="rate" position="after">
                <field name="buying_rate" digits="[12,12]" optional="hide" invisible="not currency_show_buying_rate"
                       column_invisible="context.get('hide_buying_rate')"/>
            </field>
            <field name="write_date" position="before">
                <field name="l10n_cr_source" optional="show" readonly="True" invisible="not currency_show_buying_rate"
                       column_invisible="context.get('hide_buying_rate')"/>
            </field>
        </field>
    </record>
    <record id="view_currency_rate_search" model="ir.ui.view">
        <field name="name">res.currency.rate.search.inherit.res_currency_cr_adapter</field>
        <field name="model">res.currency.rate</field>
        <field name="inherit_id" ref="base.view_currency_rate_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <filter name="l10n_cr_source_bccr" string="From the BCCR" domain="[('l10n_cr_source', '=', 'bccr')]"/>
                <filter name="l10n_cr_source_manual" string="Entered manually" domain="[('l10n_cr_source', '=', 'manual')]"/>
            </field>
        </field>
    </record>
    <record id="view_currency_form" model="ir.ui.view">
        <field name="name">res.currency.form.inherit.res_currency_cr_adapter</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <!-- Where a buying rate is shown, Odoo's rate columns are replaced by the same values labelled as selling -->
            <xpath expr="//field[@name='rate_ids']//field[@name='name']" position="attributes">
                <attribute name="column_invisible">parent.show_buying_rate</attribute>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='name']" position="after">
                <field name="l10n_cr_date" string="Date" column_invisible="not parent.show_buying_rate"/>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='company_rate']" position="attributes">
                <attribute name="column_invisible">parent.show_buying_rate</attribute>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='inverse_company_rate']" position="attributes">
                <attribute name="column_invisible">parent.show_buying_rate</attribute>
            </xpath>
            <!-- The update's status and actions, also for accounting administrators, who can't open Settings -->
            <xpath expr="//form/div[hasclass('alert')]" position="before">
                <header invisible="not l10n_cr_show_update" groups="account.group_account_manager,base.group_system">
                    <button name="action_l10n_cr_update_rates" type="object" string="Update Now"/>
                    <button name="action_l10n_cr_open_rate_load_wizard" type="object" string="Load Past Rates"/>
                </header>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert" groups="account.group_account_manager,base.group_system"
                     invisible="not l10n_cr_show_update or l10n_cr_rates_status not in ('ready', 'today')">
                    <div invisible="l10n_cr_rates_status != 'ready'">
                        BCCR rates ready until <field name="l10n_cr_rates_ready_until" class="oe_inline"/><span invisible="not l10n_cr_rates_entered_manually">, entered manually</span>
                    </div>
                    <div invisible="l10n_cr_rates_status != 'today'">
                        BCCR rates ready until today<span invisible="not l10n_cr_rates_entered_manually">, entered manually</span>
                    </div>
                    <div class="small" invisible="not l10n_cr_last_update">
                        Last update <field name="l10n_cr_last_update" class="oe_inline"/>
                    </div>
                </div>
                <div class="alert alert-warning mb-0" role="alert" groups="account.group_account_manager,base.group_system"
                     invisible="not l10n_cr_show_update or l10n_cr_rates_status not in ('late', 'missing')">
                    <div invisible="l10n_cr_rates_status != 'late'">Tomorrow's BCCR rate is still missing after today's update</div>
                    <div invisible="l10n_cr_rates_status != 'missing'">Today's BCCR rate isn't loaded</div>
                    <div class="small">
                        <span invisible="not l10n_cr_retry_at">Retrying at <field name="l10n_cr_retry_at" class="oe_inline"/> · </span>
                        <span invisible="not l10n_cr_last_update">Last update <field name="l10n_cr_last_update" class="oe_inline"/></span>
                    </div>
                </div>
                <div class="alert alert-danger mb-0" role="alert" groups="account.group_account_manager,base.group_system"
                     invisible="not l10n_cr_show_update or l10n_cr_rates_status != 'error'">
                    <div>The last BCCR update failed. An administrator can check the token, or the server log</div>
                    <div class="small">
                        <span invisible="not l10n_cr_retry_at">Retrying at <field name="l10n_cr_retry_at" class="oe_inline"/> · </span>
                        <span invisible="not l10n_cr_last_update">Last update <field name="l10n_cr_last_update" class="oe_inline"/></span>
                    </div>
                </div>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='inverse_company_rate']" position="after">
                <field name="company_rate" width="140" digits="[12,12]" string="Selling Unit/Base"
                       column_invisible="not parent.show_buying_rate"/>
                <field name="buying_company_rate" width="140" digits="[12,12]" string="Buying Unit/Base"
                       column_invisible="not parent.show_buying_rate"/>
                <field name="inverse_company_rate" width="140" digits="[12,12]" string="Selling Base/Unit"
                       column_invisible="not parent.show_buying_rate"/>
                <field name="buying_inverse_company_rate" width="140" digits="[12,12]" string="Buying Base/Unit"
                       column_invisible="not parent.show_buying_rate"/>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='write_date']" position="before">
                <field name="buying_rate" digits="[12,12]" optional="hide" column_invisible="not parent.show_buying_rate"/>
                <field name="l10n_cr_source" optional="show" readonly="True" column_invisible="not parent.show_buying_rate"/>
            </xpath>
        </field>
    </record>
    <!-- Odoo's "Show Currency Rates" is replaced by one that hides the buying columns where they don't apply -->
    <record id="base.act_view_currency_rates" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="action_view_currency_rates" model="ir.actions.server">
        <field name="name">Show Currency Rates</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="binding_model_id" ref="base.model_res_currency"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = record.action_view_rates()</field>
    </record>
</odoo>
