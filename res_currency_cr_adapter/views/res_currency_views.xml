<odoo>
    <record id="view_currency_rate_tree" model="ir.ui.view">
        <field name="name">res.currency.rate.list.inherit.res_currency_cr_adapter</field>
        <field name="model">res.currency.rate</field>
        <field name="inherit_id" ref="base.view_currency_rate_tree"/>
        <field name="arch" type="xml">
            <!-- New lines go first, as the rates are sorted newest first -->
            <xpath expr="/list" position="attributes">
                <attribute name="editable">top</attribute>
            </xpath>
            <!-- Without the currency in the view a new line gets no default currency, and no previous rate to copy -->
            <field name="name" position="after">
                <field name="currency_id" column_invisible="True"/>
            </field>
            <field name="inverse_company_rate" position="after">
                <field name="buying_company_rate" width="140" digits="[12,12]" invisible="not buying_company_rate"/>
                <field name="buying_inverse_company_rate" width="140" digits="[12,12]" invisible="not buying_company_rate"/>
            </field>
            <field name="rate" position="after">
                <field name="buying_rate" digits="[12,12]" optional="hide"/>
            </field>
        </field>
    </record>
    <record id="view_currency_form" model="ir.ui.view">
        <field name="name">res.currency.form.inherit.res_currency_cr_adapter</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <!-- Where a buying rate is shown, Odoo's rate columns are replaced by the same values labelled as selling -->
            <xpath expr="//field[@name='rate_ids']//field[@name='company_rate']" position="attributes">
                <attribute name="column_invisible">parent.show_buying_rate</attribute>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='inverse_company_rate']" position="attributes">
                <attribute name="column_invisible">parent.show_buying_rate</attribute>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='inverse_company_rate']" position="after">
                <field name="company_rate" width="140" digits="[12,12]" string="Selling Unit/Base"
                       column_invisible="not parent.show_buying_rate"/>
                <field name="buying_company_rate" width="140" digits="[12,12]" string="Buying Unit/Base"
                       column_invisible="not parent.show_buying_rate"/>
                <field name="inverse_company_rate" width="140" digits="[12,12]" string="Selling Base/Unit"
                       column_invisible="not parent.show_buying_rate"/>
                <field name="buying_inverse_company_rate" width="140" digits="[12,12]" string="Buying Base/Unit"
                       column_invisible="not parent.show_buying_rate"/>
            </xpath>
            <xpath expr="//field[@name='rate_ids']//field[@name='write_date']" position="before">
                <field name="buying_rate" digits="[12,12]" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
