<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_crc_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.crc.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='main_currency_setting_container']" position="inside">
                <setting help="Token generated on the BCCR SDDE site" documentation="https://sdd.bccr.fi.cr/es/IndicadoresEconomicos/Inicio/MiPerfil">
                    <field name="bccr_token" password="True"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
