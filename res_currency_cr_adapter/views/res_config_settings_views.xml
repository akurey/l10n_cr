<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.res_currency_cr_adapter</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='main_currency_setting_container']" position="inside">
                <setting id="l10n_cr_exchange_rates" string="BCCR Exchange Rates" company_dependent="1" help="Load the BCCR's selling and buying rates of the dollar automatically, every evening" invisible="not group_multi_currency or not l10n_cr_rates_available">
                    <field name="l10n_cr_bccr_rates_enabled"/>
                    <div class="content-group mt16" invisible="not l10n_cr_bccr_rates_enabled">
                        <div class="text-warning" invisible="l10n_cr_bccr_token">
                            <i class="oi" data-icon="warning"/> Enter the BCCR token to start loading the rates
                        </div>
                        <div invisible="not l10n_cr_bccr_token">
                            <div class="text-success" invisible="l10n_cr_rates_status != 'ready'">
                                <i class="oi" data-icon="check"/> Rates updated through <field name="l10n_cr_rates_ready_until" class="oe_inline"/>
                            </div>
                            <div class="text-warning" invisible="l10n_cr_rates_status != 'late'">
                                <i class="oi" data-icon="warning"/> Tomorrow's rate isn't loaded yet, rates updated through <field name="l10n_cr_rates_ready_until" class="oe_inline"/>
                            </div>
                            <div class="text-warning" invisible="l10n_cr_rates_status != 'missing' or not l10n_cr_rates_ready_until">
                                <i class="oi" data-icon="warning"/> Today's rate is missing, rates updated through <field name="l10n_cr_rates_ready_until" class="oe_inline"/>
                            </div>
                            <div class="text-warning" invisible="l10n_cr_rates_status != 'missing' or l10n_cr_rates_ready_until">
                                <i class="oi" data-icon="warning"/> No rates loaded yet, use "Update now" to load them
                            </div>
                            <div class="text-muted small" invisible="not l10n_cr_next_update">
                                Next automatic update <field name="l10n_cr_next_update" class="oe_inline"/>
                            </div>
                            <div class="text-muted small" invisible="not l10n_cr_last_update">
                                Last update<span invisible="not l10n_cr_last_update_error"> failed</span> <field name="l10n_cr_last_update" class="oe_inline"/>
                            </div>
                            <div class="text-danger small" invisible="not l10n_cr_last_update_error or l10n_cr_rates_status == 'ready'">
                                <field name="l10n_cr_last_update_error" class="w-100"/>
                            </div>
                            <div class="mt8">
                                <button name="action_l10n_cr_update_rates" type="object" class="btn-link px-0 me-3" icon="refresh" string="Update now"/>
                                <button name="action_l10n_cr_open_rate_load_wizard" type="object" class="btn-link px-0" icon="history" string="Load past rates"/>
                            </div>
                        </div>
                    </div>
                </setting>
                <setting id="l10n_cr_bccr_token" string="BCCR Token" help="Shared by all companies" invisible="not group_multi_currency or not l10n_cr_rates_available or not l10n_cr_bccr_rates_enabled">
                    <field name="l10n_cr_bccr_token" password="True"/>
                    <div class="mt8" invisible="l10n_cr_bccr_token">
                        <a href="https://sdd.bccr.fi.cr/es/IndicadoresEconomicos/Inicio/MiPerfil" target="_blank" class="btn-link" role="button">
                            <i class="oi" data-icon="east"/> Generate a free token on the BCCR's site
                        </a>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
