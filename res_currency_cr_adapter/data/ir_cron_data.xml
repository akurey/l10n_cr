<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_currency_rate_update" model="ir.cron">
        <field name="name">Costa Rica: Update currency rates</field>
        <field name="model_id" ref="model_res_currency_rate"/>
        <field name="state">code</field>
        <field name="code">model._cron_update()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 13:00:00')"/>
    </record>
</odoo>
