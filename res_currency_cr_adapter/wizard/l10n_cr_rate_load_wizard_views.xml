<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_cr_rate_load_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_cr.rate.load.wizard.form</field>
        <field name="model">l10n_cr.rate.load.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="replace"/>
                </group>
                <footer>
                    <button name="action_load" type="object" string="Load" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
