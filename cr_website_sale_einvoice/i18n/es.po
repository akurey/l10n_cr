msgstr "Los pedidos con factura electrónica se facturan con estos datos."

#. module: cr_website_sale_einvoice
#: model_terms:ir.ui.view,arch_db:cr_website_sale_einvoice.einvoice_form
msgid "Press \"Save\" to request it."
msgstr "Para pedirla, tocar \"Guardar\"."

#. module: cr_website_sale_einvoice
#: model:ir.model,name:cr_website_sale_einvoice.model_sale_order
msgid "Sales Order"
msgstr "Orden de venta"

