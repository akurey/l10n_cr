#. module: cr_website_sale_einvoice
#: model:ir.model.fields,help:cr_website_sale_einvoice.field_sale_order__cr_einvoice_requested
msgid ""
"The customer asked for an electronic invoice (FE) in their name. Otherwise "
"the order is invoiced with an electronic ticket (TE)."
msgstr ""
"El cliente pidió factura electrónica (FE) a su nombre. Si no, el pedido se "
"factura con tiquete electrónico (TE)."

#. module: cr_website_sale_einvoice
#: model:ir.model.fields,help:cr_website_sale_einvoice.field_sale_order__cr_einvoice_verified
msgid ""
"The customer's identification was found in Hacienda's registry when they "
"asked for the electronic invoice. If not, check their data before invoicing."
msgstr ""
"La identificación del cliente se encontró en el registro de Hacienda al "
"pedir la factura electrónica. Si no, revisar sus datos antes de facturar."

#. module: cr_website_sale_einvoice
#. odoo-python
#: code:addons/cr_website_sale_einvoice/models/res_partner.py:0
msgid ""
"The identification number must have %(lengths)s digits, with no leading "
"zero, dashes or spaces."
msgstr ""
"El número de identificación debe tener %(lengths)s dígitos, sin cero al "
"inicio, guiones ni espacios."

#. module: cr_website_sale_einvoice
#: model_terms:ir.ui.view,arch_db:cr_website_sale_einvoice.einvoice_form
