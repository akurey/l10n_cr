#. module: cr_website_sale_einvoice
#. odoo-python
#: code:addons/cr_website_sale_einvoice/controllers/main.py:0
msgid "Too many identification lookups. Try again in an hour."
msgstr ""
"Demasiadas consultas de identificación. Intentar de nuevo en una hora."

#. module: cr_website_sale_einvoice
#: model_terms:ir.ui.view,arch_db:cr_website_sale_einvoice.einvoice_form
msgid "Without it, an electronic ticket is issued."
msgstr "Sin ella, se emite un tiquete electrónico."

#. module: cr_website_sale_einvoice
#. odoo-python
#: code:addons/cr_website_sale_einvoice/controllers/main.py:0
msgid "Write the e-mail address where the third party receives the invoice."
msgstr "Escribir el correo donde el tercero recibe la factura."

#. module: cr_website_sale_einvoice
#: model_terms:ir.ui.view,arch_db:cr_website_sale_einvoice.portal_einvoice_page
