<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_einvoice" model="ir.ui.view">
        <field name="name">sale.order.form.cr.einvoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_invoice_id']" position="after">
                <field name="cr_einvoice_requested" widget="boolean_toggle"/>
                <field name="cr_einvoice_partner_id" invisible="not cr_einvoice_requested"/>
                <field name="cr_einvoice_verified" invisible="not cr_einvoice_requested"/>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_einvoice" model="ir.ui.view">
        <field name="name">sale.order.list.quotation.cr.einvoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="cr_einvoice_requested" optional="show" widget="boolean"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_einvoice" model="ir.ui.view">
        <field name="name">sale.order.list.cr.einvoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="cr_einvoice_requested" optional="show" widget="boolean"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_einvoice" model="ir.ui.view">
        <field name="name">sale.order.search.cr.einvoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter string="Electronic Invoice" name="cr_einvoice" domain="[('cr_einvoice_requested', '=', True)]"/>
                <filter string="Electronic Invoice to Check" name="cr_einvoice_unverified"
                        domain="[('cr_einvoice_requested', '=', True), ('cr_einvoice_verified', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
